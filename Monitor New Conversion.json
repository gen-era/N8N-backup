    {
      "parameters": {
        "jsCode": "// Conversions sonuçlarını map'e çevir\nconst conversionsMap = {};\n$input.all().forEach(item => {\n  conversionsMap[item.json.id_source_value] = item.json.uniqueref;\n});\n\n// Get Run Refs node'undan gelen item'ları al\nconst previousNode = $('Get Run Refs');\nreturn previousNode.all().map(item => ({\n  json: {\n    path: item.json.path,\n    run_id: item.json.run_id,\n    conversion_id: item.json.conversion_id,\n    run_ref: item.json.run_ref,\n    conversion_ref: conversionsMap[item.json.conversion_id] || null\n  }\n}));"

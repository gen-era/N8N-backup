    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    dor.account_id,\n    dor.uniqueref AS recipe_ref,\n    dop.batch_source_value,\n    r.run_id,\n    COUNT(DISTINCT dop.read_ref) AS sample_count\nFROM data_operations dop\nINNER JOIN data_operation_recipes dor\n    ON dop.recipe_ref = dor.uniqueref\nLEFT JOIN reads rd\n    ON dop.read_ref = rd.uniqueref\nLEFT JOIN conversions c\n    ON rd.conversion_ref = c.uniqueref\nLEFT JOIN runs r\n    ON c.run_ref = r.uniqueref\nWHERE dop.status_concept_ref = 24\n    AND dor.platform_concept_ref = 398\n    AND dor.type_concept_ref = 251\n    AND dor.account_id IS NOT NULL\nGROUP BY dor.account_id, dor.uniqueref, dop.batch_source_value, r.run_id\nORDER BY dor.account_id, dor.uniqueref, r.run_id, dop.batch_source_value;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -464,
        -48
      ],
      "id": "56c815f9-5e82-44b3-b631-5eef4da152a2",
      "name": "Get Delivery Jobs",
      "credentials": {
        "postgres": {
          "id": "vvzB2Z8ymgMiekHW",
          "name": "PG-ALB-1.5"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    '{{ $json.account_id }}'         AS account_id,\n    '{{ $json.batch_source_value }}' AS batch_source_value,\n    array_agg(dop.uniqueref)         AS dop_refs,\n    array_agg(r.r1_path) FILTER (WHERE r.r1_path IS NOT NULL)\n      || array_agg(r.r2_path) FILTER (WHERE r.r2_path IS NOT NULL) AS files,\n    COUNT(*)                         AS read_count\nFROM data_operations dop\nINNER JOIN data_operation_recipes dor\n    ON dop.recipe_ref = dor.uniqueref\nINNER JOIN reads r\n    ON r.uniqueref = dop.read_ref\nWHERE dop.status_concept_ref = 24\n    AND dor.account_id = '{{ $json.account_id }}'\n    AND dor.uniqueref  = {{ $json.recipe_ref }}\n    AND dop.batch_source_value = '{{ $json.batch_source_value }}';",
        "options": {}
      },

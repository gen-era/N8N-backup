      {
        "parameters": {
          "jsCode": "const dbRows = $('Execute a SQL query').all().map(i => i.json);\nconst allItems = JSON.parse($('list sentrix ids').first().json.items_json);\nconst instruments = $('Execute SQL: Get Instruments').all().map(i => i.json);\nconst kits = $('Execute SQL: Get Kits Mapping').all().map(i => i.json);\n\nconst dbMap = {};\ndbRows.forEach(row => { dbMap[row.sentrix_id] = row; });\n\nconst instrumentMap = {};\ninstruments.forEach(i => { instrumentMap[i.serial_number] = i; });\n\nconst kitsMap = {};\nkits.forEach(k => { kitsMap[k.source_value] = k; });\n\nconst results = [];\n\nfor (const item of allItems) {\n  const { sentrix_id, status, scan_date, instrument_serial, descriptor } = item;\n  const dbRecord = dbMap[sentrix_id];\n  const instrument = instrumentMap[instrument_serial] || {};\n  const kit = kitsMap[descriptor] || {};\n\n  if (!dbRecord) {\n    if (status === 'completed') {\n      results.push({\n        json: {\n          action: 'insert_completed',\n          sentrix_id, scan_date,\n          instrument_ref: instrument.uniqueref || null,\n          chiptype_ref: kit.kits_ref || null,\n          care_site_ref: instrument.care_site_ref || null\n        }\n      });\n    } else {\n      results.push({\n        json: {\n          action: 'insert_inprogress',\n          sentrix_id\n        }\n      });\n    }\n  } else if (parseInt(dbRecord.status_concept_ref) === 29 || parseInt(dbRecord.status_concept_ref) === 27) {\n    continue;\n  } else if (parseInt(dbRecord.status_concept_ref) === 26) {\n    if (status === 'completed') {\n      results.push({\n        json: {\n          action: 'update_completed',\n          uniqueref: dbRecord.uniqueref,\n          sentrix_id, scan_date,\n          instrument_ref: instrument.uniqueref || null,\n          chiptype_ref: kit.kits_ref || null,\n          care_site_ref: instrument.care_site_ref || null\n        }\n      });\n    } else {\n      const elapsed = (new Date() - new Date(dbRecord.updated_at)) / 1000 / 60;\n      if (elapsed > 60) {\n        results.push({\n          json: {\n            action: 'update_failed',\n            uniqueref: dbRecord.uniqueref,\n            sentrix_id\n          }\n        });\n      }\n    }\n  }\n}\n\nreturn results.length > 0 ? results : [{ json: { action: 'none' } }];"
        },

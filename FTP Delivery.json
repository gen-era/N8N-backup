    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    '{{ $json.account_id }}'         AS account_id,\n    '{{ $json.batch_source_value }}' AS batch_source_value,\n    array_agg(dop.uniqueref)         AS dop_refs,\n    array_agg(r.r1_path) FILTER (WHERE r.r1_path IS NOT NULL)\n      || array_agg(r.r2_path) FILTER (WHERE r.r2_path IS NOT NULL) AS files,\n    COUNT(*)                         AS read_count\nFROM data_operations dop\nINNER JOIN data_operation_recipes dor\n    ON dop.recipe_ref = dor.uniqueref\nINNER JOIN reads r\n    ON r.uniqueref = dop.read_ref\nWHERE dop.status_concept_ref = 24\n    AND dor.account_id = '{{ $json.account_id }}'\n    AND dor.uniqueref  = {{ $json.recipe_ref }}\n    AND dop.batch_source_value = '{{ $json.batch_source_value }}';",
        "options": {}

    {
      "parameters": {
        "jsCode": "const items = $input.all().map(item => item.json);\nconst webhookUrl = 'http://10.20.0.30:5678/webhook/3883600a-ff60-4431-bcef-16e71ff99971';\nconst timestamp = new Date().getTime();\n\nconst batchHasUmi = items.every(i => String(i.HAS_UMI).trim() === 'true');\n\nconst commands = items.map((item, index) => {\n  const files = item.LOCAL_FILES.split('\\n').filter(f => f.trim());\n\n  const firstFile = files[0].trim();\n  const parentDir = firstFile.substring(0, firstFile.lastIndexOf('/'));\n\n  const uploadCommands = files.map(file => {\n    const fileName = file.trim().substring(file.trim().lastIndexOf('/') + 1);\n    // cd sonrası sadece fileName kullan\n    const uploadCmd = `~/bin/icav2 projectdata upload \"${fileName}\" /input_folder/${item.SAMPLE_ID}/${fileName} --project-id ${item.PROJECT_ID} --num-workers 4`;\n\n    return `(${uploadCmd} || (echo \"Retry 1/3 for ${fileName}\" && sleep 5 && ${uploadCmd}) || (echo \"Retry 2/3 for ${fileName}\" && sleep 10 && ${uploadCmd}) || (echo \"Retry 3/3 for ${fileName}\" && sleep 15 && ${uploadCmd}))`;\n  });\n\n  // parentDir tırnak içinde - DÜZEN gibi Türkçe karakter koruması\n  const uploadCommand = `cd \"${parentDir}\" && ${uploadCommands.join(' && ')}`;\n\n  const itemWithBatch = { ...item, BATCH_HAS_UMI: batchHasUmi };\n  const itemJson = JSON.stringify(itemWithBatch);\n  const encodedJson = Buffer.from(itemJson).toString('base64');\n\n  return `${uploadCommand} && sleep 60 && echo \"[$(date '+%Y-%m-%d %H:%M:%S')] Sending webhook for ${item.SAMPLE_ID}\" && echo '${encodedJson}' | base64 -d | curl -X POST \"${webhookUrl}\" -H \"Content-Type: application/json\" -d @- --max-time 30`;\n}).join(' && ');\n\nconst logFile = `/tmp/upload_webhook_batch_${timestamp}.log`;\n\nreturn [{\n  json: {\n    command: `(${commands}) > ${logFile} 2>&1 &`,\n    logFile: logFile,\n    totalItems: items.length,\n    BATCH_HAS_UMI: batchHasUmi\n  }\n}];"
      },

        "jsCode": "const items = $input.all();\nreturn items\n  .filter(item => {\n    try {\n      const parsed = JSON.parse(item.json.stdout);\n      return !parsed.skip;\n    } catch {\n      return false;\n    }\n  })\n  .map(item => ({ json: JSON.parse(item.json.stdout) }));"
      },

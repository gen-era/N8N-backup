    {
      "parameters": {
        "jsCode": "const stdout = $input.first().json.stdout.trim();\nif (!stdout) return [];\n\nconst lines = stdout.split('\\n').filter(f => f.trim());\n\nreturn lines.map(line => {\n  try {\n    const parsed = JSON.parse(line.trim());\n    return { json: parsed };\n  } catch {\n    return { json: { path: line.trim() } };\n  }\n});"
      },

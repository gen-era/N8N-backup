    {
      "parameters": {
        "httpMethod": "POST",
        "path": "bcl-error",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -112,
        128
      ],
      "id": "85f24f0a-bcf7-42a7-9b41-3b1dabd5ef78",
      "name": "Error Webhook",
      "webhookId": "bcl-error"
    },
    {
      "parameters": {
        "jsCode": "// Extract error details from webhook\nconst rawInput = $input.first().json;\n\n// The data could be directly in json (if testing) or in json.body (from actual webhook)\nconst input = rawInput.body || rawInput;\n\nconst errorInfo = {\n  run_id: input.run_id || 'unknown',\n  error_stage: input.error_stage || 'unknown',\n  exit_code: input.exit_code || -1,\n  error_message: input.error_message || 'Unknown error',\n  timestamp: new Date().toISOString(),\n  path: input.path || '',\n  scriptDir: input.scriptDir || '/staging/n8n_tmp',\n  full_payload: input\n};\n\nconsole.error('BCL Convert Error:', JSON.stringify(errorInfo, null, 2));\n\nreturn [{ json: errorInfo }];"
      },
      "id": "fdf1ad67-9750-4d44-b405-1ddf1cf052df",
      "name": "Parse Error Details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        112,
        128
      ]
    },
    {
      "parameters": {
        "command": "=# Remove Processing.txt and create BCLConvertError.txt\nrm -f \"{{ $json.path }}/Processing.txt\" 2>/dev/null || true\n\n# Create error marker file with details\nERROR_FILE=\"{{ $json.path }}/BCLConvertError.txt\"\necho \"========================================\" > \"$ERROR_FILE\"\necho \"BCL Convert Pipeline Error\" >> \"$ERROR_FILE\"\necho \"========================================\" >> \"$ERROR_FILE\"\necho \"\" >> \"$ERROR_FILE\"\necho \"Run ID: {{ $json.run_id }}\" >> \"$ERROR_FILE\"\necho \"Error Stage: {{ $json.error_stage }}\" >> \"$ERROR_FILE\"\necho \"Exit Code: {{ $json.exit_code }}\" >> \"$ERROR_FILE\"\necho \"Error Message: {{ $json.error_message }}\" >> \"$ERROR_FILE\"\necho \"Timestamp: {{ $json.timestamp }}\" >> \"$ERROR_FILE\"\necho \"\" >> \"$ERROR_FILE\"\necho \"Log files location:\" >> \"$ERROR_FILE\"\necho \"{{ $json.scriptDir }}/{{ $json.run_id }}_stage*.log\" >> \"$ERROR_FILE\"\necho \"\" >> \"$ERROR_FILE\"\necho \"========================================\" >> \"$ERROR_FILE\"\n\necho \"Created error file: $ERROR_FILE\""
      },
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        336,
        128
      ],
      "id": "d64832a0-2837-4283-9125-26b92c4e7ce5",

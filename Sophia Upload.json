        "executeOnce": false,
        "command": "=fdfind --fixed-strings \"{{ $json.sample_id }}_\"  /mnt/illuminastorage/fastq_folder/{{ $json.id_source_value }}"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        -1456,

      "parameters": {
        "jsCode": "const stdout = $input.first().json.stdout.trim();\nif (!stdout) return [];\n\nconst lines = stdout.split('\\n').filter(f => f.trim());\n\nreturn lines.map(line => {\n  try {\n    return { json: JSON.parse(line.trim()) };\n  } catch {\n    return null;\n  }\n}).filter(item => item !== null);"
      },

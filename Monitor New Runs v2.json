    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const it of $input.all()) {\n  const lines = String(it.json.stdout || '').split('\\n');\n  for (const ln of lines) {\n    const t = ln.trim();\n    if (!t) continue;\n    const p = t.split('|');\n    out.push({ json: { run_id: p[0] || '', path: p[1] || '', ok: (p[2] || '') === 'OK' } });\n  }\n}\nreturn out;"

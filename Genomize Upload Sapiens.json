      ],
      "id": "d7c44f41-30ac-49c6-ad51-527951105dde",
      "name": "Expand Recipe Items"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst recipeMap = {};\n\nitems.forEach(item => {\n  const recipeRef = item.json.recipe_ref;\n  if (!recipeMap[recipeRef]) {\n    recipeMap[recipeRef] = [];\n  }\n  recipeMap[recipeRef].push(item.json);\n});\n\nreturn Object.keys(recipeMap).map(recipeRef => ({\n  json: {\n    recipe_ref: Number(recipeRef),\n    operations: recipeMap[recipeRef]\n  }\n}));"
      },

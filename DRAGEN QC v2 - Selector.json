  "name": "DRAGEN QC v2 - Selector",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "formTitle": "DRAGEN QC v2 — Örnek Seçici",
        "formDescription": "İşlenecek run_id'leri gir (birden çoksa virgülle ayır). Her batch (sample_project) için CES/WES/WES+mt/HCS v2 kitlerinden 3 rastgele örnek QC kuyruğuna eklenir.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "run_ids",
              "fieldType": "text",
              "requiredField": true,
              "placeholder": "260522_A01228_0288_AHW77FDSXF, 260522_A01978_0180_..."
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "Run Input Form",
      "name": "Run Input Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.3,
      "position": [
        -600,
        0
      ],
      "webhookId": "a7c1f3e0-9b2d-4c55-8e10-2f6b1d4a7e90"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH eligible AS (\n  SELECT rd.uniqueref AS read_ref, rd.sample_project, r.run_id,\n         ROW_NUMBER() OVER (PARTITION BY r.run_id, rd.sample_project\n                            ORDER BY random()) AS rn\n  FROM reads rd\n  JOIN conversions c ON c.uniqueref = rd.conversion_ref\n  JOIN runs r        ON r.uniqueref = c.run_ref\n  WHERE r.run_id IN (\n          SELECT trim(x) FROM unnest(string_to_array('{{ $json.run_ids }}', ',')) AS x\n        )\n    AND rd.kit_ref IN (1, 40, 73, 97)\n    AND NOT EXISTS (\n      SELECT 1 FROM data_operations dop\n      WHERE dop.read_ref = rd.uniqueref AND dop.recipe_ref = 6\n        AND dop.status_concept_ref IN (24, 26, 29)\n    )\n)\nINSERT INTO data_operations (read_ref, recipe_ref, status_concept_ref, batch_source_value)\nSELECT read_ref, 6, 24, sample_project\nFROM eligible\nWHERE rn <= 3\nRETURNING uniqueref, read_ref, batch_source_value;",
        "options": {}
      },
      "id": "Select & Queue",
      "name": "Select & Queue",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -340,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "vvzB2Z8ymgMiekHW",
          "name": "PG-ALB-1.5"
        }
      }
    },
    {

    {
      "parameters": {
        "jsCode": "// Group items by recipe_ref AND storage location (derived from r1_path)\nconst getLocation = (r1Path) => {\n  if (!r1Path) return 'unknown';\n  if (r1Path.startsWith('/mnt/illuminastorage/')) return 'illuminastorage';\n  if (r1Path.startsWith('/volume1/ALLDATA/')) return 'alldata';\n  return 'other';\n};\n\nconst grouped = {};\nfor (const item of $input.all()) {\n  const recipeRef = item.json.recipe_ref;\n  const location = getLocation(item.json.r1_path);\n  const groupKey = `${recipeRef}__${location}`;\n\n  if (!grouped[groupKey]) {\n    grouped[groupKey] = {\n      recipe_ref: recipeRef,\n      location: location,\n      items: []\n    };\n  }\n  grouped[groupKey].items.push(item.json);\n}\n\n// Return as array of groups\nreturn Object.values(grouped).map(group => ({\n  json: {\n    recipe_ref: group.recipe_ref,\n    location: group.location,\n    items: group.items,\n    count: group.items.length\n  }\n}));"
      },

    {
      "parameters": {
        "command": "=FOLDER=\"/volume1/ALLDATA/Scans/{{ $json.sentrix_id }}/\"; SENTRIX=\"{{ $json.sentrix_id }}\"; POSITION=\"{{ $json.position }}\"; GREEN=$(ls \"${FOLDER}${SENTRIX}_${POSITION}_Grn.idat\" 2>/dev/null | head -1); RED=$(ls \"${FOLDER}${SENTRIX}_${POSITION}_Red.idat\" 2>/dev/null | head -1); TOTAL_RESCAN=$(ls \"${FOLDER}\"Metrics_old*.txt 2>/dev/null | wc -l | tr -d ' '); POS_RESCAN=$(for f in \"${FOLDER}\"Metrics_old*.txt; do [[ \"$f\" == *\"Metrics_old0.txt\" ]] && continue; grep -q \"${POSITION}_\" \"$f\" && echo \"$f\"; done 2>/dev/null | wc -l | tr -d ' '); IS_RESCANNED=$(grep -q \"${POSITION}_\" \"${FOLDER}Metrics.txt\" 2>/dev/null && echo 1 || echo 0); if [ \"$IS_RESCANNED\" = \"1\" ]; then POS_RESCAN=$((POS_RESCAN + 1)); fi; echo \"{\\\"green_idat_path\\\":\\\"$GREEN\\\",\\\"red_idat_path\\\":\\\"$RED\\\",\\\"total_rescan_count\\\":$TOTAL_RESCAN,\\\"position_rescan_count\\\":$POS_RESCAN,\\\"is_rescanned\\\":$IS_RESCANNED}\""
      },

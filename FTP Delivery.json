          "name": "Koza ALLData - Can User"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const it = $input.item.json;\nconst target = `/volume1/${it.account_id}/${it.batch_source_value}`;\nconst quoted = it.files.map(f => `\"${f}\"`).join(' ');\n\nreturn {\n  json: {\n    ...it,\n    target,\n    file_count: it.files.length,\n    rsync_cmd: `mkdir -p \"${target}.partial\" && rsync -av --no-perms ${quoted} \"${target}.partial/\" && chmod 644 \"${target}.partial\"/*.fastq.gz && rm -rf \"${target}\" && mv \"${target}.partial\" \"${target}\"`,\n    verify_cmd: `ls \"${target}\"/*.fastq.gz | wc -l`,\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        176,

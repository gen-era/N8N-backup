    {
      "parameters": {
        "jsCode": "// Job detaylarini sample bazina genislet, tek JSON binary uret (require yok)\nconst rows = [];\nfor (const item of $input.all()) {\n  const d = item.json.data || item.json;\n  const base = {\n    submitter: d.user_email ?? null,\n    name:      d.name ?? null,\n    id:        d.job_id ?? null,\n    date:      d.submit_time ?? null,\n    panel:     d.target_region_name ?? null,\n    status:    d.job_status_name ?? null,\n  };\n  const samples = Array.isArray(d.samples) ? d.samples : [];\n  if (samples.length === 0) {\n    rows.push({ ...base, sample_id: null, sample_name: null });\n  } else {\n    for (const s of samples) {\n      rows.push({ ...base, sample_id: s.id ?? null, sample_name: s.name ?? null });\n    }\n  }\n}\nconst base64 = Buffer.from(JSON.stringify(rows), 'utf8').toString('base64');\nreturn [{\n  json: { count: rows.length },\n  binary: { data: { data: base64, mimeType: 'application/json', fileName: 'archer_in.json', fileExtension: 'json' } },\n}];\n"
      },

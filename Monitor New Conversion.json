    },
    {
      "parameters": {
        "jsCode": "const paths = $input.item.json.stdout.trim().split(',').filter(p => p.length > 0);\nreturn paths.map(path => {\n  const trimmedPath = path.trim();\n  // Path'in son dizin adını al (trailing slash'i kaldırarak)\n  const dirName = trimmedPath.replace(/\\/$/, '').split('/').pop();\n  // Run ID'yi çıkar (ilk tire karakterine kadar olan kısım)\n  const runId = dirName.split('-')[0];\n  // Conversion ID tüm dizin adı (trailing slash olmadan)\n  const conversionId = dirName;\n  \n  return { \n    json: { \n      path: trimmedPath,\n      run_id: runId,\n      conversion_id: conversionId\n    } \n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1136,
        272
      ],
      "id": "3f377d72-9e96-4395-8b5f-3d20bec64045",
      "name": "Split Runs"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT uniqueref, run_id \nFROM runs \nWHERE run_id IN ({{ $input.first().json.run_ids.map(id => `'${id}'`).join(',') }})",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",

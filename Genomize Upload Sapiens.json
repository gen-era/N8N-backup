    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    dor.account_id,\n    dor.uniqueref AS recipe_ref,\n    dor.pipeline_id,\n    dor.pipeline_name,\n    STRING_AGG(DISTINCT k.name, ', ' ORDER BY k.name) AS kit_names,\n    STRING_AGG(DISTINCT cs.care_site_name, ', ' ORDER BY cs.care_site_name) AS sample_owners,\n    STRING_AGG(DISTINCT dop.batch_source_value, ', ' ORDER BY dop.batch_source_value) AS batches,\n    COUNT(dop.uniqueref) AS total_data_operations,\n    STRING_AGG(DISTINCT r.run_id, ', ' ORDER BY r.run_id) AS run_ids,\n    STRING_AGG(DISTINCT rd.sample_id, ', ' ORDER BY rd.sample_id) AS sample_ids\nFROM data_operations dop\nINNER JOIN data_operation_recipes dor ON dop.recipe_ref = dor.uniqueref\nINNER JOIN reads rd                   ON dop.read_ref = rd.uniqueref\nINNER JOIN conversions c              ON rd.conversion_ref = c.uniqueref\nINNER JOIN runs r                     ON c.run_ref = r.uniqueref\nLEFT JOIN  kits k                     ON dor.kit_ref = k.uniqueref\nLEFT JOIN  care_site cs               ON rd.requesting_caresite_ref = cs.uniqueref\nWHERE dop.uniqueref IN ({{ $('Loop Over Items').item.json.operations.map(o => o.operation_uniqueref).join(',') }})\nGROUP BY dor.account_id, dor.uniqueref, dor.pipeline_id, dor.pipeline_name;",
        "options": {}
      },

    {
      "parameters": {
        "command": "SKIP_LOG=\"/tmp/scan_skip_log\"; TIMER_LOG=\"/tmp/scan_timer_log\"; PROCESSED=\"/tmp/scan_processed\"; touch \"$SKIP_LOG\" \"$TIMER_LOG\"; > \"$PROCESSED\"; while IFS= read -r SENTRIX; do [ -z \"$SENTRIX\" ] && continue; FOLDER=\"/volume1/ALLDATA/Scans/${SENTRIX}/\"; METRICS=$(ls \"${FOLDER}\"Metrics*.txt 2>/dev/null | grep -v old | head -1); if [ -n \"$METRICS\" ]; then sed -i \"/^${SENTRIX}$/d\" \"$SKIP_LOG\"; sed -i \"/^${SENTRIX}/d\" \"$TIMER_LOG\"; echo \"$SENTRIX\" >> \"$PROCESSED\"; echo \"{\\\"new\\\":true,\\\"path\\\":\\\"$METRICS\\\"}\"; fi; done < \"$SKIP_LOG\"; for FOLDER in /volume1/ALLDATA/Scans/*/; do SENTRIX=$(basename \"$FOLDER\" | tr -d ' /'); [[ \"$SENTRIX\" == *\"diag\"* ]] && continue; grep -q \"^$SENTRIX$\" \"$SKIP_LOG\" && continue; grep -q \"^$SENTRIX$\" \"$PROCESSED\" && continue; METRICS=$(ls \"${FOLDER}\"Metrics*.txt 2>/dev/null | grep -v old | head -1); if [ -z \"$METRICS\" ]; then FIRST_SEEN=$(grep \"^${SENTRIX} \" \"$TIMER_LOG\" | awk '{print $2}'); if [ -z \"$FIRST_SEEN\" ]; then echo \"$SENTRIX $(date +%s)\" >> \"$TIMER_LOG\"; else NOW=$(date +%s); ELAPSED=$((NOW - FIRST_SEEN)); if [ $ELAPSED -gt 1800 ]; then echo \"{\\\"skip\\\":true,\\\"reason\\\":\\\"Metrics.txt bulunamadi (30 dk)\\\",\\\"sentrix_id\\\":\\\"$SENTRIX\\\"}\"; echo \"$SENTRIX\" >> \"$SKIP_LOG\"; sed -i \"/^${SENTRIX}/d\" \"$TIMER_LOG\"; fi; fi; continue; fi; [ ! -f \"${FOLDER}Effective.cfg\" ] && echo \"{\\\"skip\\\":true,\\\"reason\\\":\\\"Effective.cfg bulunamadi\\\",\\\"sentrix_id\\\":\\\"$SENTRIX\\\"}\" && echo \"$SENTRIX\" >> \"$SKIP_LOG\" && continue; [ ! -f \"${FOLDER}${SENTRIX}_qc.txt\" ] && [ ! -f \"${FOLDER}${SENTRIX}.sdf\" ] && echo \"{\\\"skip\\\":true,\\\"reason\\\":\\\"qc.txt ve sdf bulunamadi\\\",\\\"sentrix_id\\\":\\\"$SENTRIX\\\"}\" && echo \"$SENTRIX\" >> \"$SKIP_LOG\" && continue; if [ \"$METRICS\" -nt /tmp/last_scan_check ]; then echo \"{\\\"new\\\":true,\\\"path\\\":\\\"$METRICS\\\"}\"; fi; done; touch /tmp/last_scan_check"
      },

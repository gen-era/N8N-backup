    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  r.uniqueref, \n  r.run_id, \n  r.workflow_concept_ref, \n  wc.concept_name AS workflow_concept_name,\n  i.instrument_id,\n  ic.concept_name AS instrument_concept_name\nFROM runs r\nLEFT JOIN concepts wc ON r.workflow_concept_ref = wc.uniqueref\nLEFT JOIN instruments i ON r.instrument_ref = i.uniqueref\nLEFT JOIN concepts ic ON i.instrument_concept_ref = ic.uniqueref\nWHERE r.run_id IN ({{ $input.first().json.run_ids.map(id => `'${id}'`).join(',') }})",
        "options": {}
      },

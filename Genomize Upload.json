      ],
      "id": "4c50f3a6-8035-4ef0-8042-15ad3c634308",
      "name": "Create Symlink"
    },
    {
      "parameters": {
        "jsCode": "const findFilesResults = $input.all();\nconst expandedItems = $('Expand Recipe Items').all();\n\nconst batchSourceValue = expandedItems[0].json.batch_source_value.trim();\nconst accountId = expandedItems[0].json.account_id.trim();\nconst symlinkBaseDir = `/tmp/genomize/${batchSourceValue}`;\n\nconst commands = [`mkdir -p ${symlinkBaseDir}`];\nconst operationRefs = [];\n\nfindFilesResults.forEach((result, index) => {\n  const fastqPaths = result.json.stdout.trim().split('\\n').filter(p => p);\n  const opRef = expandedItems[index].json.operation_uniqueref;\n  operationRefs.push(opRef);\n\n  fastqPaths.forEach(sourcePath => {\n    const fileName = sourcePath.split('/').pop();\n    commands.push(`ln -sf ${sourcePath} ${symlinkBaseDir}/${fileName}`);\n  });\n});\n\nreturn [{\n  json: {\n    command: commands.join(' && '),\n    targetDirectory: symlinkBaseDir,\n    batchSourceValue,\n    accountId,\n    operationRefs\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1136,
        -48
      ],
      "id": "3c917ed2-b7cc-43ee-b825-97cf5e0331fa",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "executeOnce": false,
        "command": "=fdfind \"{{ $json.sample_id }}_\"  /mnt/smb_share/Conversions/{{ $json.id_source_value }}"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        928,
        -48
      ],
      "id": "545b08bf-8360-445d-aef0-d74b12a806fc",

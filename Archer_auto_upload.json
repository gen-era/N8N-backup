    {
      "parameters": {
        "jsCode": "const stdout = $input.first().json.stdout || '';\n\n// JSON kısmını yakala (object)\nconst match = stdout.match(/\\{[\\s\\S]*\\}$/);\n\nif (!match) {\n  throw new Error('JSON not found in stdout:\\n' + stdout);\n}\n\nlet parsed;\ntry {\n  parsed = JSON.parse(match[0]);\n} catch (e) {\n  throw new Error('Invalid JSON:\\n' + match[0]);\n}\n\n// Genel başarı durumu\nconst jobSuccess = parsed.success;\n\n// Sample bilgisi direkt yok → count var\n// Ama senin önceki node’dan sample listesi geliyor olabilir\n// Burada fallback olarak count kadar item üretelim\n\nconst samplesCount = parsed.samples_count || 0;\n\n// Her sample için item üret\nconst items = [];\n\nfor (let i = 0; i < samplesCount; i++) {\n  items.push({\n    json: {\n      job_id: parsed.job_id,\n      job_name: parsed.job_name,\n      success: jobSuccess,\n      error: parsed.error,\n      sample_index: i + 1,\n      samples_count: samplesCount\n    }\n  });\n}\n\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

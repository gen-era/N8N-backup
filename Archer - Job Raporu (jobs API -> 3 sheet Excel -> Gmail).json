      "parameters": {
        "jsCode": "// Job detayini yalnizca gerekli alanlara indir (dev settings/sequence bloklarini at)\nreturn $input.all().map(item => {\n  const d = item.json.data || item.json;\n  const s = Array.isArray(d.samples) ? d.samples : [];\n  return { json: {\n    user_email: d.user_email ?? null,\n    name: d.name ?? null,\n    job_id: d.job_id ?? null,\n    submit_time: d.submit_time ?? null,\n    target_region_name: d.target_region_name ?? null,\n    job_status_name: d.job_status_name ?? null,\n    samples: s.map(x => ({ id: x.id ?? null, name: x.name ?? null })),\n  }};\n});\n"

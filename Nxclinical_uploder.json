    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\n\nconst sampleList = items.map(i => `<li>${i.sample_id}</li>`).join('\\n');\n\nconst body = `\n<p>Aşağıdaki örnekler NxClinical platformuna yüklenmiştir.</p>\n<ul>\n${sampleList}\n</ul>\n`;\n\nreturn [{\n  json: {\n    email_body: body\n  }\n}];"
      },

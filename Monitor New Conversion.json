      ],
      "id": "f9582196-4f8d-41c0-965f-d6732df1b9be",
      "name": "Prepare IDs"
    },
    {
      "parameters": {
        "jsCode": "// Supabase sonuçlarını map'e çevir (her row bir item olarak geliyor)\nconst runsMap = {};\n$input.all().forEach(item => {\n  runsMap[item.json.run_id] = item.json.uniqueref;\n});\n\n// Bir önceki node'dan gelen orijinal item'ları al ve run_ref ekle\nconst originalNode = $('Split Runs');\nreturn originalNode.all().map(item => ({\n  json: {\n    path: item.json.path,\n    run_id: item.json.run_id,\n    conversion_id: item.json.conversion_id,\n    run_ref: runsMap[item.json.run_id] || null\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

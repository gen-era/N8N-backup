    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  r.uniqueref            AS read_ref,\n  r.sample_id,\n  r.reads,\n  r.kit_ref,\n  k.name                 AS kit_name,\n  k.required_se_reads,\n  r.requesting_caresite_ref,\n  cs_req.care_site_name  AS requester_name,\n  r.performing_caresite_ref,\n  cs_perf.care_site_name AS performing_name,\n  dor.uniqueref          AS recipe_ref,\n  dor.pipeline_id,\n  dor.account_id\nFROM reads r\nLEFT JOIN kits k\n  ON k.uniqueref = r.kit_ref\nLEFT JOIN care_site cs_req\n  ON cs_req.uniqueref = r.requesting_caresite_ref\nLEFT JOIN care_site cs_perf\n  ON cs_perf.uniqueref = r.performing_caresite_ref\nLEFT JOIN data_operation_recipes dor\n  ON dor.kit_ref                  = r.kit_ref\n  AND dor.requesting_caresite_ref = r.requesting_caresite_ref\n  AND dor.performing_caresite_ref = r.performing_caresite_ref\n  AND dor.platform_concept_ref    = 12\nLEFT JOIN data_operations dop\n  ON dop.read_ref = r.uniqueref\nWHERE r.conversion_ref = {{ $json.conversion_ref }}\n  AND dop.uniqueref IS NULL\nORDER BY r.sample_id;",
        "options": {}
      },

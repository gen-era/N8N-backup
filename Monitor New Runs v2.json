      },
      "name": "Find Runs",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        -528,
        -32
      ],
      "id": "ad264d0e-3ab4-4814-9d0b-c3a7a96f9644"
    },
    {
      "parameters": {
        "jsCode": "// Diskte bulunan run klasörlerini {run_id, path} listesine çevir, tekilleştir,\n// tek SQL sorgusu için VALUES dizesi üret.\nconst raw = ($input.first().json.stdout || '').trim();\nconst seen = new Set();\nconst rows = [];\nfor (const part of raw.split(',')) {\n  const path = part.trim();\n  if (!path) continue;\n  const m = path.match(/([^\\/]+)\\/?$/);\n  if (!m) continue;\n  const run_id = m[1];\n  if (seen.has(run_id)) continue;\n  seen.add(run_id);\n  rows.push({ run_id, path });\n}\nif (rows.length === 0) return [];\nconst esc = s => String(s).replace(/'/g, \"''\");\nconst values = rows.map(r => `('${esc(r.run_id)}','${esc(r.path)}')`).join(',');\nreturn [{ json: { values, count: rows.length } }];\n"
      },
      "name": "Parse Runs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -320,
        -32
      ],
      "id": "b57358ca-d37a-435f-a675-7326c3c1d262"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM (\n  SELECT fs.run_id, fs.path,\n    CASE\n      WHEN r.uniqueref IS NULL THEN 'new'\n      WHEN r.status_concept_ref IN (24, 26) THEN 'in_progress'\n      WHEN r.status_concept_ref = 29\n           AND NOT EXISTS (\n             SELECT 1 FROM measurement_run mr WHERE mr.run_ref = r.uniqueref\n           )\n        THEN 'needs_interop'\n      WHEN r.status_concept_ref IS DISTINCT FROM 27\n           AND (\n             r.instrument_ref IS NULL\n             OR r.flowcell_kit_ref IS NULL\n             OR r.flowcell_lot IS NULL\n             OR r.date IS NULL\n             OR r.reads_settings_concept_ref IS NULL\n             OR r.workflow_concept_ref IS NULL\n             OR r.care_site_ref IS NULL\n             OR r.seq_started_at IS NULL\n             OR r.seq_ended_at IS NULL\n           )\n           AND COALESCE(\n             to_date(substring(fs.run_id FROM '^[0-9]{6}'), 'YYMMDD'),\n             CURRENT_DATE\n           ) > CURRENT_DATE - INTERVAL '30 days'\n        THEN 'incomplete'\n      ELSE NULL\n    END AS reason\n  FROM (VALUES {{ $json.values }}) AS fs(run_id, path)\n  LEFT JOIN runs r ON r.run_id = fs.run_id\n) q\nWHERE q.reason IS NOT NULL",
        "options": {}
      },
      "name": "Classify Runs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -80,
        -32
      ],

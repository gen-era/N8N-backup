    {
      "parameters": {
        "jsCode": "// Supabase sonuçlarını map'e çevir - tüm bilgileri taşı\nconst runsMap = {};\n$input.all().forEach(item => {\n  runsMap[item.json.run_id] = {\n    uniqueref: item.json.uniqueref,\n    workflow_concept_name: item.json.workflow_concept_name,\n    instrument_id: item.json.instrument_id,\n    instrument_concept_name: item.json.instrument_concept_name\n  };\n});\n\n// Orijinal item'ları al ve tüm bilgileri ekle\nconst originalNode = $('Split Runs');\nreturn originalNode.all().map(item => {\n  const runData = runsMap[item.json.run_id] || {};\n  return {\n    json: {\n      path: item.json.path,\n      run_id: item.json.run_id,\n      conversion_id: item.json.conversion_id,\n      run_ref: runData.uniqueref || null,\n      workflow_concept_name: runData.workflow_concept_name || null,\n      instrument_id: runData.instrument_id || null,\n      instrument_concept_name: runData.instrument_concept_name || null\n    }\n  };\n});"
      },

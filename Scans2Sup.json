      ],
      "id": "44d3c185-e360-45fa-9820-a35140507962",
      "name": "Parse File List"
    },
    {
      "parameters": {
        "command": "=FILEPATH=\"{{ $json.path }}\"; FOLDER=$(dirname \"$FILEPATH\"); SENTRIX=$(basename \"$FOLDER\" | tr -d ' '); METRICS_FILE=$(ls \"$FOLDER\"/Metrics*.txt 2>/dev/null | grep -v old | head -1); RAW_DATE=$(sed -n '2p' \"$METRICS_FILE\" | awk '{print $1}'); SCAN_DATE=$(python3 -c \"from datetime import datetime; print(datetime.strptime('$RAW_DATE', '%m/%d/%Y').strftime('%Y-%m-%d'))\"); INSTRUMENT=$(grep -m1 \"^name = \" \"$FOLDER/Effective.cfg\" 2>/dev/null | awk '{print $3}'); DESCRIPTOR=$(grep -m1 \"Descriptor:\" \"$FOLDER/${SENTRIX}_qc.txt\" 2>/dev/null | sed 's/.*Descriptor:[[:space:]]*//' | awk -F'   ' '{print $1}' | xargs); if [ -z \"$DESCRIPTOR\" ]; then DESCRIPTOR=$(grep -m1 \"<Name>\" \"$FOLDER/${SENTRIX}.sdf\" 2>/dev/null | sed 's/.*<Name>\\(.*\\)<\\/Name>.*/\\1/' | xargs); fi; echo \"{\\\"sentrix_id\\\":\\\"$SENTRIX\\\",\\\"scan_date\\\":\\\"$SCAN_DATE\\\",\\\"instrument_serial\\\":\\\"$INSTRUMENT\\\",\\\"descriptor\\\":\\\"$DESCRIPTOR\\\"}\""
      },

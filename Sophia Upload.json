      ],
      "id": "134ee9d2-0eaf-4e30-bb97-9c90d5f3f2a1",
      "name": "Create Symlink"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// recipe_ref'e göre grupla\nconst groups = {};\n\nitems.forEach(item => {\n  const json = item.json;\n  const recipeRef = json.recipe_ref;\n  const stdout = json.stdout || '';\n  \n  if (!groups[recipeRef]) {\n    groups[recipeRef] = {\n      recipe_ref: recipeRef,\n      target_dir: `/tmp/sophia/recipe_${recipeRef}`,\n      commands: [`mkdir -p /tmp/sophia/recipe_${recipeRef}`],\n      // Sonraki node için lazım olabilecek metadata\n      account_id: json.account_id,\n      pipeline_id: json.pipeline_id,\n    };\n  }\n  \n  // Bu item'ın fastq dosyalarını ekle\n  const fastqPaths = stdout.trim().split('\\n').filter(p => p.length > 0);\n  fastqPaths.forEach(sourcePath => {\n    const fileName = sourcePath.split('/').pop();\n    const targetPath = `/tmp/sophia/recipe_${recipeRef}/${fileName}`;\n    groups[recipeRef].commands.push(`ln -sf \"${sourcePath}\" \"${targetPath}\"`);\n  });\n});\n\n// Her recipe_ref için bir item döndür\nreturn Object.values(groups).map(group => ({\n  json: {\n    recipe_ref: group.recipe_ref,\n    target_dir: group.target_dir,\n    account_id: group.account_id,\n    pipeline_id: group.pipeline_id,\n    command: group.commands.join(' && '),\n    file_count: group.commands.length - 1 // mkdir hariç\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1008,
        -448
      ],
      "id": "333030b1-e7fa-4cdb-b556-a9eb68e5246d",
      "name": "Code in JavaScript"
    },

    {
      "parameters": {
        "jsCode": "const conversionsMap = {};\n$input.all().forEach(item => {\n  conversionsMap[item.json.id_source_value] = item.json.uniqueref;\n});\n\nconst previousNode = $('Tidy Run Refs');\nreturn previousNode.all().map(item => ({\n  json: {\n    path: item.json.path,\n    run_id: item.json.run_id,\n    conversion_id: item.json.conversion_id,\n    run_ref: item.json.run_ref,\n    conversion_ref: conversionsMap[item.json.conversion_id] || null,\n    workflow_concept_name: item.json.workflow_concept_name,\n    instrument_id: item.json.instrument_id,\n    instrument_concept_name: item.json.instrument_concept_name\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -528,
        416
      ],
      "id": "52aa8335-81d8-4d2b-bfed-f3b28478393c",
      "name": "Tidy Conversion Ref"
    },
    {
      "parameters": {
        "jsCode": "const inputText = $json.stdout;\nif (!inputText || typeof inputText !== 'string') {\n  throw new Error('stdout bulunamadı veya string değil');\n}\n\n// Cihaz bilgisini Filter node'undan al\nconst instrumentName = $('Filter').first().json.instrument_concept_name;\nconst isNextSeq2000 = instrumentName === 'Illumina NextSeq 2000';\n\nconst dataSectionMatch = inputText.split('Data]');\nif (dataSectionMatch.length < 2) {\n  throw new Error('Sample sheet içinde [Data] section bulunamadı');\n}\nconst dataSection = dataSectionMatch[dataSectionMatch.length - 1];\nconst lines = dataSection.trim().split('\\n').filter(line => line.trim());\nif (lines.length < 2) {\n  throw new Error('[Data] section\\'da yeterli satır yok');\n}\n\nconst headers = lines[0].split(',');\nconst hasLaneColumn = headers.includes('Lane');\n\nfunction reverseComplement(seq) {\n  if (!seq) return '';\n  const complement = { 'A': 'T', 'T': 'A', 'C': 'G', 'G': 'C',\n                        'a': 't', 't': 'a', 'c': 'g', 'g': 'c' };\n  return seq.split('').reverse().map(base => complement[base] || base).join('');\n}\n\nconst samples = [];\nfor (let i = 1; i < lines.length; i++) {\n  const values = lines[i].split(',');\n  const sample = {};\n  headers.forEach((header, index) => {\n    sample[header] = values[index] || '';\n  });\n\n  if (!hasLaneColumn) {\n    sample['Lane'] = '0';\n  }\n\n  if (isNextSeq2000 && sample['Index2']) {\n    sample['Index2'] = reverseComplement(sample['Index2']);\n  }\n\n  samples.push(sample);\n}\n\nreturn samples.map(sample => ({ json: sample }));"
      },

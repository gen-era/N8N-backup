    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    p.id,\n    p.name,\n    '{{ $('Build Commands').item.json.account_id }}'         AS account_id,\n    '{{ $('Build Commands').item.json.batch_source_value }}' AS batch_source_value,\n    '{{ $('Build Commands').item.json.target }}'             AS target_path,\n    {{ $('Build Commands').item.json.file_count }}           AS file_count,\n    string_agg(DISTINCT r.run_id, ', '  ORDER BY r.run_id)   AS run_ids,\n    string_agg(DISTINCT k.name, ', '   ORDER BY k.name)      AS kit_names,\n    string_agg(DISTINCT rd.sample_id, ', ' ORDER BY rd.sample_id) AS sample_ids,\n    COUNT(DISTINCT dop.uniqueref)                            AS total_data_operations\nFROM data_operations dop\nLEFT JOIN providers p              ON dop.operator_ref = p.uniqueref\nLEFT JOIN reads rd                 ON dop.read_ref = rd.uniqueref\nLEFT JOIN conversions c            ON rd.conversion_ref = c.uniqueref\nLEFT JOIN runs r                   ON c.run_ref = r.uniqueref\nLEFT JOIN kits k                   ON rd.kit_ref = k.uniqueref\nWHERE dop.uniqueref = ANY(ARRAY[{{ $('Build Commands').item.json.dop_refs.join(',') }}]::bigint[])\n  AND p.id IS NOT NULL\nGROUP BY p.id, p.name;",
        "options": {}
      },

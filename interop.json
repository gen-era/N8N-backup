        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse JSON output from summary_interop Lane level\n  const rawOutput = $('Execute Command1').first().json.stdout;\nconst sanitized = rawOutput.replace(/\\bNaN\\b/g, 'null');\nconst jsonOutput = JSON.parse(sanitized);\n\n  // Get concepts from Postgres node\n  const concepts = $('Select rows from a table2').all().map(item => item.json);\n\n  // Filter only non-index reads (IsIndex: 78 = non-index reads)\n  const nonIndexReads = jsonOutput.filter(row => row.IsIndex === 78);\n\n  // Map ReadNumber to R notation (1→R1, 4→R2)\n  const readMapping = {\n    1: 'R1',\n    4: 'R2'\n  };\n\n  // Metrics to extract\n  const metricsToSave = [\n    \"Cluster Count\",\n    \"Cluster Count Pf\",\n    \"Error Rate\",\n    \"% Aligned\",\n    \"% >= Q30\",\n    \"% Occupied\",\n    \"Reads\",\n    \"Reads Pf\",\n    \"Yield G\"\n  ];\n\n  // Build output array for database insertion\n  const measurements = [];\n\n  for (const row of nonIndexReads) {\n    const lane = row.Lane;\n    const readNumber = row.ReadNumber;\n    const readLabel = readMapping[readNumber];\n\n    // Skip if read number is not in our mapping (safety check)\n    if (!readLabel) {\n      console.warn(`Unknown ReadNumber: ${readNumber}`);\n      continue;\n    }\n\n    for (const metricName of metricsToSave) {\n      const value = row[metricName];\n\n      // Skip null, undefined, NaN, or empty values\n      if (value === null || value === undefined || value === '' ||\n          (typeof value === 'number' && isNaN(value))) {\n        continue;\n      }\n\n      // Construct concept name: \"{Metric} L{Lane} {ReadLabel}\"\n      const conceptName = `${metricName} L${lane} ${readLabel}`;\n\n      // Find matching concept\n      const concept = concepts.find(c => c.concept_name === conceptName);\n\n      if (concept) {\n        measurements.push({\n          concept_id: concept.uniqueref,\n          concept_name: conceptName,\n          value: parseFloat(value),\n          lane: lane,\n          read: readLabel\n        });\n      } else {\n        console.warn(`Concept not found: ${conceptName}`);\n      }\n    }\n  }\n\n  return measurements.map(m => ({ json: m }));"
      },

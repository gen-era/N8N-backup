    {
      "parameters": {
        "command": "=SRC=\"{{ $json.folder_path }}\"\nDST=\"/mnt/smb_peta/{{ $json.run_id }}\"\n\n# Copy with checksums, preserving everything\nrsync -avh --checksum --progress \"$SRC/\" \"$DST/\"\n\n# Verify — this re-checksums both sides and should report no differences\nrsync -avhn --checksum \"$SRC/\" \"$DST/\""

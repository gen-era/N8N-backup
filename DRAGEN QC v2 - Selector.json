    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH batch_done AS (\n  SELECT r.run_id, rd.sample_project, COUNT(DISTINCT rd.uniqueref) AS done_cnt\n  FROM reads rd\n  JOIN conversions c ON c.uniqueref = rd.conversion_ref\n  JOIN runs r        ON r.uniqueref = c.run_ref\n  JOIN data_operations dop ON dop.read_ref = rd.uniqueref AND dop.recipe_ref = 6\n                          AND dop.status_concept_ref IN (24, 26, 29)\n  WHERE r.run_id IN (SELECT trim(x) FROM unnest(string_to_array('{{ $json.run_ids }}', ',')) AS x)\n    AND rd.kit_ref IN (1, 40, 73, 97)\n  GROUP BY r.run_id, rd.sample_project\n),\neligible AS (\n  SELECT rd.uniqueref AS read_ref, rd.sample_project, r.run_id,\n         ROW_NUMBER() OVER (PARTITION BY r.run_id, rd.sample_project\n                            ORDER BY random()) AS rn\n  FROM reads rd\n  JOIN conversions c ON c.uniqueref = rd.conversion_ref\n  JOIN runs r        ON r.uniqueref = c.run_ref\n  WHERE r.run_id IN (SELECT trim(x) FROM unnest(string_to_array('{{ $json.run_ids }}', ',')) AS x)\n    AND rd.kit_ref IN (1, 40, 73, 97)\n    AND NOT EXISTS (SELECT 1 FROM data_operations dop WHERE dop.read_ref = rd.uniqueref\n                      AND dop.recipe_ref = 6 AND dop.status_concept_ref IN (24, 26, 29))\n)\nINSERT INTO data_operations (read_ref, recipe_ref, status_concept_ref, batch_source_value)\nSELECT e.read_ref, 6, 24, e.sample_project\nFROM eligible e\nLEFT JOIN batch_done bd ON bd.run_id = e.run_id AND bd.sample_project = e.sample_project\nWHERE e.rn <= (3 - COALESCE(bd.done_cnt, 0))\nRETURNING uniqueref, read_ref, batch_source_value;",
        "options": {}
      },

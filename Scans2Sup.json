      "parameters": {
        "jsCode": "const items = $input.all();\nconst sentrixIds = items.map(item => `'${item.json.sentrix_id}'`).join(',');\nconst descriptors = [...new Set(\n  items.filter(i => i.json.descriptor).map(i => `'${i.json.descriptor.replace(/'/g, \"''\")}'`)\n)].join(',');\nconst instruments = [...new Set(\n  items.filter(i => i.json.instrument_serial).map(i => `'${i.json.instrument_serial.replace(/'/g, \"''\")}'`)\n)].join(',');\n\nreturn [{ \n  json: { \n    sentrix_ids: sentrixIds, \n    items_json: JSON.stringify(items.map(i => i.json)),\n    descriptors: descriptors || \"'__none__'\",\n    instruments: instruments || \"'__none__'\"\n  } \n}];"
      },

      "parameters": {
        "jsCode": "const stdout = $input.first().json.stdout;\n\nif (!stdout) {\n  throw new Error('stdout is empty');\n}\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(stdout);\n} catch (e) {\n  throw new Error('stdout is not valid JSON:\\n' + stdout);\n}\n\n// Eğer array dönüyorsa → n8n item formatına çevir\nif (Array.isArray(parsed)) {\n  return parsed.map(item => ({ json: item }));\n}\n\n// Eğer object ise direkt dön\nreturn [{ json: parsed }];"

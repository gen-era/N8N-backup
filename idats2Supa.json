      "parameters": {
        "command": "curl -g 'https://sheets.googleapis.com/v4/spreadsheets/1BqKAsezocz_ECKbgR66WY6hwKW8Es8U-y5HA7IIqsE4/values/Sayfa2%21A%3AZ?key=AIzaSyDwKbA0snP_-YQMTQ_Q9x87cXCcP3QQ_cc'\n"

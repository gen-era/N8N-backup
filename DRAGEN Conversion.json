    {
      "parameters": {
        "jsCode": "// CSV string'i al\nconst csvData = $input.first().json.stdout;\n\n// Satırlara ayır\nconst lines = csvData.trim().split('\\n');\n\n// Header'ı parse et\nconst headers = lines[0].split(',');\n\n// Data satırlarını parse et ve objelere dönüştür\nconst tableData = lines.slice(1).map(line => {\n  const values = line.split(',');\n  const row = {};\n  \n  headers.forEach((header, index) => {\n    row[header] = values[index];\n  });\n  \n  return row;\n});\n\n// Sonucu döndür\nreturn tableData.map(row => ({ json: row }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -672,
        0
      ],
      "id": "0620d715-0659-43e1-9acb-0166e1751d62",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// Workflow kontrolü\nconst workflowType = $('Get Run Ref').first().json.workflow_type;\n\n\n// Gelen JSON verisini al (artık CSV parse etmiyoruz)\nconst parsedData = $input.all().map(item => item.json);\n\nlet result;\n\nif (workflowType === \"Standard Workflow\") {\n  // SampleID'ye göre grupla ve reads'leri topla\n  const grouped = {};\n  \n  parsedData.forEach(item => {\n    const sampleId = item['SampleID'];\n    \n    if (!grouped[sampleId]) {\n      // İlk kez görülen sample - kopyala\n      grouped[sampleId] = { ...item };\n      grouped[sampleId]['# Reads'] = parseInt(item['# Reads'].replace(/,/g, '')) || 0;\n      grouped[sampleId]['Lane'] = '0';  // Lane'i 0 yap\n    } else {\n      // Zaten var - reads'i ekle\n      grouped[sampleId]['# Reads'] += parseInt(item['# Reads'].replace(/,/g, '')) || 0;\n    }\n  });\n  \n  // Objeyi array'e çevir\n  result = Object.values(grouped);\n  \n} else {\n  // Normal workflow - olduğu gibi bırak\n  result = parsedData;\n}\n\nreturn result.map(item => ({ json: item }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

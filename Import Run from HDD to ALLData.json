        "command": "=fdfind \"^(25|26|2026|2025)\" /mnt/alldata_usb1 /mnt/alldata_usb2 \\\n  --max-depth 2 \\\n  --exclude \"*-*\" \\\n  --exclude \"*.zip\" | paste -sd ','"

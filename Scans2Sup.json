      "parameters": {
        "command": "ls -d /volume1/ALLDATA/Scans/*/ | grep -vE '/(diag|RAWDATA|GTCs)/$' | while read FOLDER; do SENTRIX=$(basename \"$FOLDER\" | tr -d ' /'); METRICS=$(ls \"${FOLDER}\"Metrics*.txt 2>/dev/null | grep -v old | head -1); HAS_CFG=$([ -f \"${FOLDER}Effective.cfg\" ] && echo \"true\" || echo \"false\"); HAS_QC=$([ -f \"${FOLDER}${SENTRIX}_qc.txt\" ] && echo \"true\" || echo \"false\"); HAS_SDF=$([ -f \"${FOLDER}${SENTRIX}.sdf\" ] && echo \"true\" || echo \"false\"); if [ -n \"$METRICS\" ] && [ \"$HAS_CFG\" = \"true\" ] && ([ \"$HAS_QC\" = \"true\" ] || [ \"$HAS_SDF\" = \"true\" ]); then RAW_DATE=$(sed -n '2p' \"$METRICS\" | awk '{print $1}'); SCAN_DATE=$(python3 -c \"from datetime import datetime; print(datetime.strptime('$RAW_DATE', '%m/%d/%Y').strftime('%Y-%m-%d'))\"); INSTRUMENT=$(grep -m1 \"^name = \" \"${FOLDER}Effective.cfg\" | awk '{print $3}'); DESCRIPTOR=$(grep -m1 \"Descriptor:\" \"${FOLDER}${SENTRIX}_qc.txt\" 2>/dev/null | sed 's/.*Descriptor:[[:space:]]*//' | awk -F'   ' '{print $1}' | xargs); [ -z \"$DESCRIPTOR\" ] && DESCRIPTOR=$(grep -m1 \"<Name>\" \"${FOLDER}${SENTRIX}.sdf\" 2>/dev/null | sed 's/.*<Name>\\(.*\\)<\\/Name>.*/\\1/' | xargs); echo \"{\\\"sentrix_id\\\":\\\"$SENTRIX\\\",\\\"status\\\":\\\"completed\\\",\\\"scan_date\\\":\\\"$SCAN_DATE\\\",\\\"instrument_serial\\\":\\\"$INSTRUMENT\\\",\\\"descriptor\\\":\\\"$DESCRIPTOR\\\"}\"; else echo \"{\\\"sentrix_id\\\":\\\"$SENTRIX\\\",\\\"status\\\":\\\"in_progress\\\"}\"; fi; done"
      },
